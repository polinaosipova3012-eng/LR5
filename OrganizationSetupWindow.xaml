<Window x:Class="Lesson_Link.OrganizationSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Данные организации — LessonLink"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Closing="Window_Closing">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="{StaticResource AppPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Регистрация организации" FontSize="32" Foreground="#9798F3" FontWeight="Bold"/>
                <TextBlock Text="Заполните обязательные поля и нажмите «Сохранить»" FontSize="16" Foreground="#9798F3" Margin="0,6,0,0" Opacity="0.9"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" CornerRadius="8" Background="#FF6B6B" VerticalAlignment="Top">
                <Button Content="Отмена регистрации" Background="Transparent" Foreground="White"
                        FontSize="15" FontWeight="SemiBold" Padding="22,10" BorderThickness="0" Cursor="Hand"
                        Click="CancelRegistration_Click"/>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="White" CornerRadius="20" Padding="40" MaxWidth="920" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Обязательные данные" FontSize="22" Foreground="#9798F3" FontWeight="SemiBold" Margin="0,0,0,22"/>

                    <TextBlock Text="Полное название организации" Foreground="#9798F3" FontSize="15" Margin="0,0,0,6"/>
                    <Border x:Name="NameFieldBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                        <TextBox x:Name="NameTextBox" FontSize="16" MinHeight="46" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Город" Foreground="#9798F3" FontSize="15" Margin="0,0,0,6"/>
                    <Border x:Name="CityFieldBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                        <TextBox x:Name="CityTextBox" FontSize="16" MinHeight="46" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Юридический адрес" Foreground="#9798F3" FontSize="15" Margin="0,0,0,6"/>
                    <Border x:Name="AddressFieldBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                        <TextBox x:Name="AddressTextBox" FontSize="16" MinHeight="46" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Телефон организации" Foreground="#9798F3" FontSize="15" Margin="0,0,0,6"/>
                    <Border x:Name="PhoneFieldBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                        <TextBox x:Name="PhoneTextBox" FontSize="16" MinHeight="46" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Email организации" Foreground="#9798F3" FontSize="15" Margin="0,0,0,6"/>
                    <Border x:Name="OrgEmailFieldBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                        <TextBox x:Name="OrgEmailTextBox" FontSize="16" MinHeight="46" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="ФИО владельца / директора" Foreground="#9798F3" FontSize="15" Margin="0,0,0,6"/>
                    <Border x:Name="OwnerNameFieldBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                        <TextBox x:Name="OwnerNameTextBox" FontSize="16" MinHeight="46" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Тарифный план" Foreground="#9798F3" FontSize="15" Margin="0,0,0,6"/>
                    <Border x:Name="PlanFieldBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="0,0,0,24">
                        <ComboBox x:Name="SubscriptionPlanComboBox" FontSize="16" MinHeight="46"
                                  Foreground="#2D2850"
                                  Background="White" BorderThickness="0" VerticalContentAlignment="Center"
                                  DisplayMemberPath="Name" SelectedValuePath="Id">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#2D2850"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </Border>

                    <Border CornerRadius="25" Background="#9798F3" MaxWidth="400" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="SaveButton" Content="Сохранить" Style="{StaticResource FlatButtonStyle}"
                                FontSize="18" FontWeight="SemiBold" Padding="28,14" Height="52" Cursor="Hand"
                                Click="SaveButton_Click"/>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
