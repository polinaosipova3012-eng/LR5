<Window x:Class="Lesson_Link.TeacherStudentsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson_Link"
        mc:Ignorable="d"
        Title="Мои ученики" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}">
    <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="360"/>
            <ColumnDefinition Width="2*" MinWidth="280" MaxWidth="460"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с кнопкой возврата -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,30">
            <TextBlock 
                Text="Мои ученики" 
                FontSize="32" 
                Foreground="#9798F3" 
                FontWeight="Bold"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"/>
            <Border HorizontalAlignment="Right" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3">
                <Button 
                    Content="Назад" 
                    Background="Transparent"
                    Foreground="White"
                    FontSize="16" 
                    FontWeight="SemiBold"
                    Padding="20,10" 
                    Height="40"
                    Cursor="Hand"
                    BorderThickness="0"
                    Click="BackButton_Click"/>
            </Border>
        </Grid>

        <!-- Левая панель: Список учеников -->
        <Border 
            Grid.Row="1" Grid.Column="0"
            Background="White"
            CornerRadius="15"
            Padding="20"
            Margin="0,0,20,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Поиск:" Foreground="#9798F3" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" MinWidth="120" Margin="0,0,10,0">
                            <TextBox 
                                x:Name="SearchTextBox"
                                Padding="12" 
                                FontSize="16"
                                MinHeight="46"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"/>
                        </Border>
                        <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3">
                            <Button 
                                Content="Поиск" 
                                Background="Transparent"
                                Foreground="White"
                                FontSize="16" 
                                FontWeight="SemiBold"
                                Padding="25,12" 
                                Height="45"
                                Cursor="Hand"
                                BorderThickness="0"
                                Click="SearchButton_Click"/>
                        </Border>
                    </StackPanel>
                    <CheckBox x:Name="OnlyActiveStudentsCheckBox" Content="Только активные ученики"
                              FontSize="14" Foreground="#9798F3" IsChecked="True" Margin="0,12,0,0"
                              Checked="OnlyActiveStudentsCheckBox_Changed" Unchecked="OnlyActiveStudentsCheckBox_Changed"/>
                </StackPanel>

                <!-- Таблица учеников -->
                <DataGrid 
                    Grid.Row="1"
                    x:Name="StudentsDataGrid"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    SelectionChanged="StudentsDataGrid_SelectionChanged"
                    HeadersVisibility="Column"
                    GridLinesVisibility="All"
                    BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер" Binding="{Binding Id}" Width="SizeToHeader"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Пол" Binding="{Binding GenderDisplay}" Width="SizeToHeader"/>
                        <DataGridTextColumn Header="Дата рождения" Binding="{Binding DateOfBirth, StringFormat='{}{0:dd.MM.yyyy}'}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Возраст" Binding="{Binding AgeGroupName}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Группы" Binding="{Binding GroupName}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Родитель" Binding="{Binding ParentName}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding ParentPhone}" Width="SizeToCells"/>
                        <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="SizeToHeader" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Правая панель: Заметки -->
        <Border 
            Grid.Row="1" Grid.Column="1"
            Background="White"
            CornerRadius="15"
            Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Информация об ученике -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock 
                        x:Name="StudentNameTextBlock"
                        Text="Выберите ученика" 
                        FontSize="20" 
                        Foreground="#9798F3" 
                        FontWeight="SemiBold"
                        Margin="0,0,0,10"/>
                    <TextBlock 
                        x:Name="StudentInfoTextBlock"
                        Text="" 
                        FontSize="14" 
                        Foreground="#666"
                        TextWrapping="Wrap"/>
                    <Border HorizontalAlignment="Stretch" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#6C7AE0" Margin="0,12,0,0">
                        <Button 
                            Content="История посещаемости и успеваемости"
                            Background="Transparent"
                            Foreground="White"
                            FontSize="14" 
                            FontWeight="SemiBold"
                            Padding="16,10" 
                            Height="40"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="HistoryButton_Click"/>
                    </Border>
                </StackPanel>

                <!-- Форма добавления заметки -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock Text="Новая заметка" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                        <TextBox 
                            x:Name="NoteTextBox"
                            Padding="12" 
                            FontSize="14"
                            Height="100"
                            Background="Transparent"
                            BorderThickness="0"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    <Border HorizontalAlignment="Right" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3" Margin="0,10,0,0">
                        <Button 
                            Content="Добавить заметку" 
                            x:Name="AddNoteButton"
                            Background="Transparent"
                            Foreground="White"
                            FontSize="14" 
                            FontWeight="SemiBold"
                            Padding="20,10" 
                            Height="40"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="AddNoteButton_Click"
                            IsEnabled="False"/>
                    </Border>
                </StackPanel>

                <!-- Список заметок -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="История заметок" Foreground="#9798F3" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NotesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border 
                                        Background="#F5F5F5"
                                        CornerRadius="8"
                                        Padding="12,10,12,12"
                                        Margin="0,0,0,10"
                                        BorderBrush="#CCCCCC"
                                        BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock 
                                                Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                                FontSize="12" 
                                                Foreground="#999"
                                                Margin="0,0,0,5"/>
                                            <TextBlock 
                                                Text="{Binding Content}" 
                                                FontSize="14" 
                                                Foreground="#333"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>

