<Window x:Class="Lesson_Link.TeacherScheduleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson_Link"
        mc:Ignorable="d"
        Title="Моё расписание" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}">
    <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="220"/>
            <ColumnDefinition Width="7*" MinWidth="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с кнопкой возврата -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,30">
            <TextBlock 
                Text="Моё расписание" 
                FontSize="32" 
                Foreground="#9798F3" 
                FontWeight="Bold"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"/>
            <Border HorizontalAlignment="Right" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3">
                <Button 
                    Content="Назад" 
                    Background="Transparent"
                    Foreground="White"
                    FontSize="16" 
                    FontWeight="SemiBold"
                    Padding="20,10" 
                    Height="40"
                    Cursor="Hand"
                    BorderThickness="0"
                    Click="BackButton_Click"/>
            </Border>
        </Grid>

        <!-- Левая панель: Календарь -->
        <Border 
            Grid.Row="1" Grid.Column="0"
            Background="White"
            CornerRadius="15"
            Padding="20"
            Margin="0,0,20,0">
            <StackPanel>
                <TextBlock 
                    Text="Выберите дату" 
                    FontSize="18" 
                    Foreground="#9798F3" 
                    FontWeight="SemiBold"
                    Margin="0,0,0,15"/>
                <Calendar 
                    x:Name="ScheduleCalendar"
                    SelectedDatesChanged="ScheduleCalendar_SelectedDatesChanged"/>
            </StackPanel>
        </Border>

        <!-- Правая панель: Список занятий -->
        <Border 
            Grid.Row="1" Grid.Column="1"
            Background="White"
            CornerRadius="15"
            Padding="25">
            <StackPanel>
                <TextBlock 
                    x:Name="SelectedDateTextBlock"
                    Text="Выберите дату в календаре" 
                    FontSize="20" 
                    Foreground="#9798F3" 
                    FontWeight="SemiBold"
                    Margin="0,0,0,20"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ScheduleItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border 
                                    Background="#F5F5F5"
                                    CornerRadius="10"
                                    Padding="20"
                                    Margin="0,0,0,15"
                                    BorderBrush="#9798F3"
                                    BorderThickness="2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Группа -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding GroupName}" FontSize="20" FontWeight="Bold" Foreground="#9798F3"/>
                                            <TextBlock Text="ОТМЕНЕНО" FontSize="12" FontWeight="Bold" Foreground="#FF6B6B" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Время -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Время: " FontSize="16" Foreground="#666"/>
                                            <TextBlock Text="{Binding DateTime, StringFormat='{}{0:HH:mm}'}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                            <TextBlock Text=" — " FontSize="16" Foreground="#666" Margin="4,0"/>
                                            <TextBlock Text="{Binding EndTime, StringFormat='{}{0:HH:mm}'}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                            <TextBlock Text="  (" FontSize="14" Foreground="#666"/>
                                            <TextBlock Text="{Binding DurationMinutes}" FontSize="14" Foreground="#666"/>
                                            <TextBlock Text=" мин.)" FontSize="14" Foreground="#666"/>
                                        </StackPanel>

                                        <!-- Тема -->
                                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                            <TextBlock Text="Тема" FontSize="14" Foreground="#666"/>
                                            <TextBlock Text="{Binding Topic}" FontSize="16" FontWeight="SemiBold" Foreground="#333" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Преподаватели, аудитория, онлайн -->
                                        <StackPanel Grid.Row="3" Margin="0,0,0,8">
                                            <TextBlock FontSize="14" Foreground="#333" TextWrapping="Wrap">
                                                <Run Text="Преподаватели: " Foreground="#666"/>
                                                <Run Text="{Binding Teachers}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock FontSize="14" Foreground="#333" Margin="0,4,0,0">
                                                <Run Text="Аудитория: " Foreground="#666"/>
                                                <Run Text="{Binding Room}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock FontSize="14" Foreground="#333" Margin="0,4,0,0" TextWrapping="Wrap">
                                                <Run Text="Онлайн: " Foreground="#666"/>
                                                <Run Text="{Binding OnlineLink, TargetNullValue=—, FallbackValue=—}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Причина отмены -->
                                        <StackPanel Grid.Row="4">
                                            <TextBlock FontSize="14" Foreground="#FF6B6B" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="Причина отмены: " FontWeight="SemiBold"/>
                                                <Run Text="{Binding CancelReason}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>

