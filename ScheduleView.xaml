<UserControl x:Class="Lesson_Link.ScheduleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson_Link"
        mc:Ignorable="d"
        d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}">
    <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="240"/>
            <ColumnDefinition Width="7*" MinWidth="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с кнопкой возврата -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,30">
            <TextBlock 
                Text="Расписание занятий" 
                FontSize="32" 
                Foreground="#9798F3" 
                FontWeight="Bold"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"/>
            <Border HorizontalAlignment="Right" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3">
                <Button 
                    Content="Главная панель" 
                    Background="Transparent"
                    Foreground="White"
                    FontSize="16" 
                    FontWeight="SemiBold"
                    Padding="20,10" 
                    Height="40"
                    Cursor="Hand"
                    BorderThickness="0"
                    Click="BackButton_Click"/>
            </Border>
        </Grid>

        <!-- Левая панель: Календарь и форма -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
            <StackPanel>
                <!-- Календарь -->
                <Border 
                    Background="White"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock 
                            Text="Выберите дату" 
                            FontSize="18" 
                            Foreground="#9798F3" 
                            FontWeight="SemiBold"
                            Margin="0,0,0,15"/>
                        <Calendar 
                            x:Name="ScheduleCalendar"
                            SelectedDatesChanged="ScheduleCalendar_SelectedDatesChanged"
                            DisplayDateChanged="ScheduleCalendar_DisplayDateChanged"/>
                    </StackPanel>
                </Border>

                <!-- Форма добавления/редактирования -->
                <Border 
                    Background="White"
                    CornerRadius="15"
                    Padding="25">
                    <StackPanel>
                        <TextBlock 
                            Text="Добавить/Изменить занятие" 
                            FontSize="18" 
                            Foreground="#9798F3" 
                            FontWeight="SemiBold"
                            Margin="0,0,0,20"/>

                        <!-- Группа -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Группа" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <ComboBox 
                                    x:Name="GroupComboBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"
                                    DisplayMemberPath="Name"
                                    SelectedValuePath="Id"/>
                            </Border>
                        </StackPanel>

                        <!-- Дата и время -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Дата и время" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <DatePicker 
                                    x:Name="DateTimePicker"
                                    Padding="12" 
                                    FontSize="16"
                                    Height="45"
                                    VerticalContentAlignment="Center">
                                    <DatePicker.Resources>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="12"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                            </Border>
                        </StackPanel>

                        <!-- Время начала -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Время начала" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox 
                                    x:Name="TimeTextBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"
                                    Text="09:00"/>
                            </Border>
                        </StackPanel>

                        <!-- Тема занятия -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Тема занятия" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox 
                                    x:Name="SubjectTextBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Длительность -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Длительность (минуты)" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox 
                                    x:Name="DurationTextBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"
                                    Text="60"/>
                            </Border>
                        </StackPanel>

                        <!-- Аудитория -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Аудитория" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox 
                                    x:Name="RoomTextBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Ссылка на онлайн-занятие -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Ссылка на онлайн-занятие" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox 
                                    x:Name="OnlineLinkTextBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <CheckBox x:Name="IsCanceledCheckBox" Content="Занятие отменено"
                                      FontSize="15" Foreground="#9798F3" Checked="IsCanceledCheckBox_Changed" Unchecked="IsCanceledCheckBox_Changed"/>
                        </StackPanel>

                        <!-- Причина отмены -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Причина отмены" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox 
                                    x:Name="CancelReasonTextBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="50"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Top"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Номер занятия (Id)" Foreground="#9798F3" FontSize="14" Margin="0,0,0,6"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#F8F8F8">
                                <TextBox x:Name="ScheduleIdDisplay" IsReadOnly="True" Padding="10,6,10,8" FontSize="14" MinHeight="42"
                                         BorderThickness="0" VerticalContentAlignment="Center" Foreground="#555"/>
                            </Border>
                        </StackPanel>

                        <!-- Кнопки -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Первый ряд -->
                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3" Margin="0,0,5,10">
                                <Button 
                                    Content="Добавить" 
                                    x:Name="AddButton"
                                    Background="Transparent"
                                    Foreground="White"
                                    FontSize="14" 
                                    FontWeight="SemiBold"
                                    Padding="15,10" 
                                    Height="40"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Click="AddButton_Click"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3" Margin="5,0,0,10">
                                <Button 
                                    Content="Обновить" 
                                    x:Name="UpdateButton"
                                    Background="Transparent"
                                    Foreground="White"
                                    FontSize="14" 
                                    FontWeight="SemiBold"
                                    Padding="15,10" 
                                    Height="40"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Click="UpdateButton_Click"/>
                            </Border>
                            
                            <!-- Второй ряд -->
                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#FF6B6B" Margin="0,0,5,0">
                                <Button 
                                    Content="Удалить" 
                                    x:Name="DeleteButton"
                                    Background="Transparent"
                                    Foreground="White"
                                    FontSize="14" 
                                    FontWeight="SemiBold"
                                    Padding="15,10" 
                                    Height="40"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Click="DeleteButton_Click"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#CCCCCC" Margin="5,0,0,0">
                                <Button 
                                    Content="Очистить" 
                                    x:Name="ClearButton"
                                    Background="Transparent"
                                    Foreground="White"
                                    FontSize="14" 
                                    FontWeight="SemiBold"
                                    Padding="15,10" 
                                    Height="40"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Click="ClearButton_Click"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Правая панель: Список занятий -->
        <Border 
            Grid.Row="1" Grid.Column="1"
            Background="White"
            CornerRadius="15"
            Padding="25">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock 
                        x:Name="SelectedDateTextBlock"
                        Grid.Column="0"
                        Text="Выберите дату в календаре" 
                        FontSize="20" 
                        Foreground="#9798F3" 
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>
                    <CheckBox x:Name="ShowAllOrgScheduleCheckBox" Grid.Column="1"
                              Content="Все занятия организации"
                              FontSize="14" Foreground="#9798F3" VerticalContentAlignment="Center"
                              Checked="ShowAllOrgScheduleCheckBox_Changed" Unchecked="ShowAllOrgScheduleCheckBox_Changed"/>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ScheduleItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border 
                                    Background="#F5F5F5"
                                    CornerRadius="10"
                                    Padding="20"
                                    Margin="0,0,0,15"
                                    BorderBrush="#9798F3"
                                    BorderThickness="2"
                                    MouseLeftButtonDown="ScheduleItem_MouseLeftButtonDown"
                                    Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Группа -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock 
                                                Text="{Binding GroupName}" 
                                                FontSize="20" 
                                                FontWeight="Bold"
                                                Foreground="#9798F3"/>
                                            <TextBlock Text="  ·  " FontSize="16" Foreground="#999" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DateTime, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="14" Foreground="#666" VerticalAlignment="Center"/>
                                            <TextBlock Text="ОТМЕНЕНО" FontSize="12" FontWeight="Bold" Foreground="#FF6B6B" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Время -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Время: " FontSize="16" Foreground="#666"/>
                                            <TextBlock 
                                                Text="{Binding DateTime, StringFormat='{}{0:HH:mm}'}" 
                                                FontSize="16" 
                                                FontWeight="SemiBold"
                                                Foreground="#333"/>
                                            <TextBlock Text=" — " FontSize="16" Foreground="#666" Margin="4,0"/>
                                            <TextBlock 
                                                Text="{Binding EndTime, StringFormat='{}{0:HH:mm}'}" 
                                                FontSize="16" 
                                                FontWeight="SemiBold"
                                                Foreground="#333"/>
                                            <TextBlock Text="  (" FontSize="14" Foreground="#666"/>
                                            <TextBlock Text="{Binding DurationMinutes}" FontSize="14" Foreground="#666"/>
                                            <TextBlock Text=" мин.)" FontSize="14" Foreground="#666"/>
                                        </StackPanel>

                                        <!-- Тема -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,6">
                                            <TextBlock Text="Тема" FontSize="14" Foreground="#666"/>
                                            <TextBlock Text="{Binding Topic}" FontSize="16" FontWeight="SemiBold" Foreground="#333" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Сотрудники, аудитория, онлайн -->
                                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,6">
                                            <TextBlock FontSize="14" Foreground="#333" TextWrapping="Wrap">
                                                <Run Text="Преподаватели: " Foreground="#666"/>
                                                <Run Text="{Binding Teachers}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock FontSize="14" Foreground="#333" Margin="0,4,0,0">
                                                <Run Text="Аудитория: " Foreground="#666"/>
                                                <Run Text="{Binding Room}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock FontSize="14" Foreground="#333" Margin="0,4,0,0" TextWrapping="Wrap">
                                                <Run Text="Онлайн: " Foreground="#666"/>
                                                <Run Text="{Binding OnlineLink, TargetNullValue=—, FallbackValue=—}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="0">
                                            <TextBlock FontSize="14" Foreground="#FF6B6B" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="Причина отмены: " FontWeight="SemiBold"/>
                                                <Run Text="{Binding CancelReason}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
