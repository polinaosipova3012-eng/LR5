<UserControl x:Class="Lesson_Link.DirectionManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        d:DesignHeight="720" d:DesignWidth="1100"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}" Background="Transparent">
        <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="Направления деятельности"
                           FontSize="32" FontWeight="Bold" Foreground="#9798F3"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" CornerRadius="8" Background="#9798F3">
                    <Button Content="Главная панель"
                            Background="Transparent" Foreground="White"
                            FontSize="16" FontWeight="SemiBold" Padding="20,10" Height="40"
                            BorderThickness="0" Cursor="Hand" Click="HomeButton_Click"/>
                </Border>
            </Grid>

            <!-- Верхняя белая карточка: форма (как у учителей) -->
            <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="30" Margin="0,0,0,30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Справочник направлений (общий для системы)"
                               Foreground="#9798F3" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Название" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox x:Name="NewNameBox" FontSize="16" MinHeight="46"
                                         Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Категория" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox x:Name="NewCategoryBox" FontSize="16" MinHeight="46"
                                         Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Border CornerRadius="8" Background="#9798F3" Margin="0,0,10,0">
                            <Button Content="Добавить" Background="Transparent" Foreground="White"
                                    FontSize="16" FontWeight="SemiBold" Padding="25,12" Height="45"
                                    BorderThickness="0" Cursor="Hand" Click="Add_Click"/>
                        </Border>
                        <Border CornerRadius="8" Background="#9798F3" Margin="0,0,10,0">
                            <Button Content="Сохранить выбранное" Background="Transparent" Foreground="White"
                                    FontSize="16" FontWeight="SemiBold" Padding="25,12" Height="45"
                                    BorderThickness="0" Cursor="Hand" Click="Update_Click"/>
                        </Border>
                        <Border CornerRadius="8" Background="#FF6B6B">
                            <Button Content="Удалить" Background="Transparent" Foreground="White"
                                    FontSize="16" FontWeight="SemiBold" Padding="25,12" Height="45"
                                    BorderThickness="0" Cursor="Hand" Click="Delete_Click"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Таблица на градиенте, в белой карточке (как список учителей) -->
            <Border Grid.Row="2" Background="White" CornerRadius="15" Padding="20">
                <DataGrid x:Name="GridDirections"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="GridDirections_SelectionChanged"
                          HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="0"
                          MinHeight="280">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="SizeToCells"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
