<UserControl x:Class="Lesson_Link.TeacherGroupAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        d:DesignHeight="640" d:DesignWidth="1000"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}" Background="Transparent">
        <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Преподаватели в группах"
                           FontSize="32" FontWeight="Bold" Foreground="#9798F3"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" CornerRadius="8" Background="#9798F3">
                    <Button Content="Главная панель"
                            Background="Transparent" Foreground="White"
                            FontSize="16" FontWeight="SemiBold" Padding="20,10" Height="40"
                            BorderThickness="0" Cursor="Hand" Click="HomeButton_Click"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="240"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Назначьте преподавателя на учебную группу"
                               Foreground="#9798F3" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Группа:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9798F3"/>
                        <ComboBox Grid.Column="1" x:Name="GroupCombo" DisplayMemberPath="Name" SelectedValuePath="Id" MinHeight="40" MinWidth="120"/>
                        <TextBlock Grid.Column="2" Text="Преподаватель:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#9798F3"/>
                        <ComboBox Grid.Column="3" x:Name="TeacherCombo" DisplayMemberPath="FullName" SelectedValuePath="Id" MinHeight="40" MinWidth="120"/>
                        <CheckBox Grid.Column="4" x:Name="MainTeacherCheck" Content="Основной" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#9798F3"/>
                        <Border Grid.Column="5" CornerRadius="8" Background="#9798F3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Button Content="Назначить" Background="Transparent" Foreground="White"
                                    Padding="16,8" BorderThickness="0" Cursor="Hand" Click="Assign_Click"/>
                        </Border>
                    </Grid>

                    <DataGrid x:Name="AssignmentsGrid" Grid.Row="2"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="SizeToCells"/>
                            <DataGridCheckBoxColumn Header="Основной" Binding="{Binding IsMain}" Width="80" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" CornerRadius="8" Background="#CCCCCC" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Снять назначение (выберите строку)"
                                Background="Transparent" Foreground="White"
                                Padding="16,10" BorderThickness="0" Cursor="Hand" Click="RemoveSelected_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
