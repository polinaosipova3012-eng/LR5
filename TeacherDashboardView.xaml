<Window x:Class="Lesson_Link.TeacherDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson_Link"
        mc:Ignorable="d"
        Title="Lesson Link" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Background>
        <SolidColorBrush Color="White"/>
    </Window.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}">
        <StackPanel Margin="{StaticResource AppPageMargin}" MinWidth="640">
            <!-- Название программы и приветствие -->
            <Grid Margin="0,0,0,30">
                <TextBlock 
                    Text="LessonLink" 
                    FontSize="32" 
                    Foreground="#9798F3" 
                    FontWeight="Bold"
                    HorizontalAlignment="Left"/>
                <TextBlock 
                    x:Name="WelcomeTextBlock"
                    Text="Добро пожаловать!" 
                    FontSize="20" 
                    Foreground="#9798F3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>
            </Grid>

            <!-- Карточки: единая сетка 2×4 -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource DashboardCardBorderStyle}" Grid.Row="0" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource DashboardCardTitleStyle}" Text="Личные данные"/>
                        <TextBlock Grid.Row="1" x:Name="ProfileInfo" Style="{StaticResource DashboardCardDescriptionStyle}" Text="Просмотр и редактирование" VerticalAlignment="Center" MinHeight="40"/>
                        <Button Grid.Row="2" Style="{StaticResource DashboardNavigateButtonStyle}" Content="Перейти" Click="ProfileButton_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource DashboardCardBorderStyle}" Grid.Row="0" Grid.Column="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource DashboardCardTitleStyle}" Text="Мои группы"/>
                        <TextBlock Grid.Row="1" x:Name="GroupsCount" Style="{StaticResource DashboardCardCountStyle}" Text="0" VerticalAlignment="Center"/>
                        <Button Grid.Row="2" Style="{StaticResource DashboardNavigateButtonStyle}" Content="Перейти" Click="GroupsButton_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource DashboardCardBorderStyle}" Grid.Row="1" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource DashboardCardTitleStyle}" Text="Моё расписание"/>
                        <TextBlock Grid.Row="1" x:Name="ScheduleCount" Style="{StaticResource DashboardCardCountStyle}" Text="0" VerticalAlignment="Center"/>
                        <Button Grid.Row="2" Style="{StaticResource DashboardNavigateButtonStyle}" Content="Перейти" Click="ScheduleButton_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource DashboardCardBorderStyle}" Grid.Row="1" Grid.Column="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource DashboardCardTitleStyle}" Text="Мои ученики"/>
                        <TextBlock Grid.Row="1" x:Name="StudentsCount" Style="{StaticResource DashboardCardCountStyle}" Text="0" VerticalAlignment="Center"/>
                        <Button Grid.Row="2" Style="{StaticResource DashboardNavigateButtonStyle}" Content="Перейти" Click="StudentsButton_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource DashboardCardBorderStyle}" Grid.Row="2" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource DashboardCardTitleStyle}" Text="Посещаемость"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource DashboardCardDescriptionStyle}" Text="Отметки присутствия на занятиях по расписанию" VerticalAlignment="Center"/>
                        <Button Grid.Row="2" Style="{StaticResource DashboardNavigateButtonStyle}" Content="Перейти" Click="AttendanceButton_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource DashboardCardBorderStyle}" Grid.Row="2" Grid.Column="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource DashboardCardTitleStyle}" Text="Оценки"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource DashboardCardDescriptionStyle}" Text="Баллы, проценты, зачёт / незачёт" VerticalAlignment="Center"/>
                        <Button Grid.Row="2" Style="{StaticResource DashboardNavigateButtonStyle}" Content="Перейти" Click="GradesButton_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource DashboardCardBorderStyle}" Grid.Row="3" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource DashboardCardTitleStyle}" Text="Методика"/>
                        <TextBlock Grid.Row="1" x:Name="MaterialsCount" Style="{StaticResource DashboardCardCountStyle}" Text="0" VerticalAlignment="Center"/>
                        <Button Grid.Row="2" Style="{StaticResource DashboardNavigateButtonStyle}" Content="Перейти" Click="MaterialsButton_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Кнопка выхода -->
            <Border HorizontalAlignment="Right" Margin="0,30,0,0" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#FF6B6B">
                <Button 
                    Content="Выйти из системы" 
                    Background="Transparent"
                    Foreground="White"
                    FontSize="16" 
                    FontWeight="SemiBold"
                    Padding="25,12" 
                    Height="45"
                    Cursor="Hand"
                    BorderThickness="0"
                    Click="LogoutButton_Click"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
