<UserControl x:Class="Lesson_Link.StudentEnrollmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        d:DesignHeight="600" d:DesignWidth="960"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}" Background="Transparent">
        <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Зачисление учеников"
                           FontSize="32" FontWeight="Bold" Foreground="#9798F3"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" CornerRadius="8" Background="#9798F3">
                    <Button Content="Главная панель"
                            Background="Transparent" Foreground="White"
                            FontSize="16" FontWeight="SemiBold" Padding="20,10" Height="40"
                            BorderThickness="0" Cursor="Hand" Click="HomeButton_Click"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="220"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Зачисление и отчисление обучающихся"
                               Foreground="#9798F3" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ученик:" VerticalAlignment="Top"
                                   Margin="0,10,8,0" Foreground="#9798F3"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox x:Name="StudentSearchTextBox" FontSize="16" MinHeight="40"
                                         Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                         ToolTip="Введите имя, фамилию или отчество"
                                         TextChanged="StudentSearchTextBox_TextChanged"
                                         KeyDown="StudentSearchTextBox_KeyDown"/>
                            </Border>
                            <ListBox x:Name="StudentMatchesList" MaxHeight="140" Margin="0,6,0,0"
                                     BorderBrush="#CCCCCC" BorderThickness="1"
                                     Visibility="Collapsed"
                                     SelectionChanged="StudentMatchesList_SelectionChanged"
                                     MouseDoubleClick="StudentMatchesList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullName}" FontSize="15" Padding="4,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="SelectedStudentHint" FontSize="12" Foreground="#888888"
                                       Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Группа:" VerticalAlignment="Center"
                                   Margin="16,0,8,0" Foreground="#9798F3"/>
                        <ComboBox Grid.Row="0" Grid.Column="3" x:Name="GroupCombo"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" MinHeight="40" MinWidth="100"/>
                        <Border Grid.Row="0" Grid.Column="4" CornerRadius="8" Background="#9798F3"
                                Margin="12,0,8,0" VerticalAlignment="Center">
                            <Button Content="Зачислить" Background="Transparent" Foreground="White"
                                    Padding="12,8" BorderThickness="0" Cursor="Hand" Click="Enroll_Click"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="5" CornerRadius="8" Background="#FF6B6B" VerticalAlignment="Center">
                            <Button Content="Отчислить" Background="Transparent" Foreground="White"
                                    Padding="12,8" BorderThickness="0" Cursor="Hand" Click="Unenroll_Click"/>
                        </Border>
                    </Grid>

                    <DataGrid x:Name="MembershipGrid" Grid.Row="2"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ученик" Binding="{Binding StudentName}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Дата вступления" Binding="{Binding JoinDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="120"/>
                            <DataGridTextColumn Header="Дата выхода" Binding="{Binding LeaveDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" CornerRadius="8" Background="#9798F3" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Обновить список" Background="Transparent" Foreground="White"
                                Padding="16,10" BorderThickness="0" Cursor="Hand" Click="Refresh_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
