<UserControl x:Class="Lesson_Link.StudentHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        d:DesignHeight="720" d:DesignWidth="1100"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}" Background="Transparent">
        <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="Успеваемость и посещаемость"
                           FontSize="32" FontWeight="Bold" Foreground="#9798F3"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Border x:Name="HomeButtonHost" HorizontalAlignment="Right" CornerRadius="8" Background="#9798F3">
                    <Button Content="Главная панель"
                            Background="Transparent" Foreground="White"
                            FontSize="16" FontWeight="SemiBold" Padding="20,10" Height="40"
                            BorderThickness="0" Cursor="Hand" Click="HomeButton_Click"/>
                </Border>
            </Grid>

            <!-- Верхняя белая карточка: выбор ученика (как форма на экране учителей) -->
            <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="30" Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="Выберите обучающегося" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Stretch">
                        <TextBox x:Name="StudentSearchTextBox" FontSize="16" MinHeight="46"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 ToolTip="Введите имя или фамилию ученика"
                                 TextChanged="StudentSearchTextBox_TextChanged"
                                 KeyDown="StudentSearchTextBox_KeyDown"/>
                    </Border>
                    <ListBox x:Name="StudentMatchesList" MaxHeight="140" Margin="0,8,0,0"
                             BorderBrush="#CCCCCC" BorderThickness="1"
                             Visibility="Collapsed"
                             SelectionChanged="StudentMatchesList_SelectionChanged"
                             MouseDoubleClick="StudentMatchesList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" FontSize="15" Padding="4,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="Посещаемость" Foreground="#9798F3" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <Border Grid.Row="3" Background="White" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                <DataGrid x:Name="AttendanceGrid" IsReadOnly="True" AutoGenerateColumns="False" BorderThickness="0"
                          HeadersVisibility="Column" GridLinesVisibility="All" MinHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата/время занятия" Binding="{Binding LessonDateTime}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="120"/>
                        <DataGridTextColumn Header="Отмечено" Binding="{Binding MarkedAtText}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Grid.Row="4" Text="Успеваемость (оценки)" Foreground="#9798F3" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <Border Grid.Row="5" Background="White" CornerRadius="15" Padding="20" MinHeight="220">
                <DataGrid x:Name="GradesGrid" IsReadOnly="True" AutoGenerateColumns="False" BorderThickness="0"
                          HeadersVisibility="Column" GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAtText}" Width="140"/>
                        <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding GradeMode}" Width="120"/>
                        <DataGridTextColumn Header="Значение" Binding="{Binding GradeValue}" Width="SizeToCells"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
