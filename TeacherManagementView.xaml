<UserControl x:Class="Lesson_Link.TeacherManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson_Link"
        mc:Ignorable="d"
        d:DesignHeight="900" d:DesignWidth="1200">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}" Background="Transparent">
        <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок с кнопкой возврата -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <TextBlock 
                    Text="Управление учителями" 
                    FontSize="32" 
                    Foreground="#9798F3" 
                    FontWeight="Bold"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3">
                    <Button 
                        Content="Главная панель" 
                        Background="Transparent"
                        Foreground="White"
                        FontSize="16" 
                        FontWeight="SemiBold"
                        Padding="20,10" 
                        Height="40"
                        Cursor="Hand"
                        BorderThickness="0"
                        Click="BackButton_Click"/>
                </Border>
            </Grid>

            <!-- Форма добавления/редактирования -->
            <Border 
                Grid.Row="1"
                Background="White"
                CornerRadius="15"
                Padding="30"
                Margin="0,0,0,30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Имя -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Имя" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Grid>
                            <Border x:Name="FirstNameBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox 
                                    x:Name="FirstNameTextBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"
                                    TextChanged="FirstNameTextBox_TextChanged"
                                    GotFocus="FirstNameTextBox_GotFocus"
                                    LostFocus="FirstNameTextBox_LostFocus"/>
                            </Border>
                            <TextBlock x:Name="FirstNamePlaceholder" Text="Введите имя..." Foreground="Gray" FontSize="16"
                                       VerticalAlignment="Center" Margin="20,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock x:Name="FirstNameErrorText" Foreground="Red" FontSize="14" Margin="0,5,0,0" Visibility="Collapsed">Обязательное поле</TextBlock>
                    </StackPanel>

                    <!-- Фамилия -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Фамилия" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Grid>
                            <Border x:Name="LastNameBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox 
                                    x:Name="LastNameTextBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"
                                    TextChanged="LastNameTextBox_TextChanged"
                                    GotFocus="LastNameTextBox_GotFocus"
                                    LostFocus="LastNameTextBox_LostFocus"/>
                            </Border>
                            <TextBlock x:Name="LastNamePlaceholder" Text="Введите фамилию..." Foreground="Gray" FontSize="16"
                                       VerticalAlignment="Center" Margin="20,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock x:Name="LastNameErrorText" Foreground="Red" FontSize="14" Margin="0,5,0,0" Visibility="Collapsed">Обязательное поле</TextBlock>
                    </StackPanel>

                    <!-- Отчество -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Отчество" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="MiddleNameTextBox" FontSize="16" MinHeight="46"
                                     Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Дата найма" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <DatePicker x:Name="HireDatePicker" Height="45" FontSize="14"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Email" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Grid>
                            <Border x:Name="EmailBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox 
                                    x:Name="EmailTextBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"
                                    TextChanged="EmailTextBox_TextChanged"
                                    GotFocus="EmailTextBox_GotFocus"
                                    LostFocus="EmailTextBox_LostFocus"/>
                            </Border>
                            <TextBlock x:Name="EmailPlaceholder" Text="example@school.ru" Foreground="Gray" FontSize="16"
                                       VerticalAlignment="Center" Margin="20,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock x:Name="EmailErrorText" Foreground="Red" FontSize="14" Margin="0,5,0,0" Visibility="Collapsed">Обязательное поле</TextBlock>
                    </StackPanel>

                    <!-- Телефон -->
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Телефон" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Grid>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox 
                                    x:Name="PhoneNumberTextBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"
                                    GotFocus="PhoneNumberTextBox_GotFocus"
                                    LostFocus="PhoneNumberTextBox_LostFocus"/>
                            </Border>
                            <TextBlock x:Name="PhoneNumberPlaceholder" Text="+7 (999) 999-99-99" Foreground="Gray" FontSize="16"
                                       VerticalAlignment="Center" Margin="20,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <!-- Адрес -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                        <TextBlock Text="Адрес" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Grid>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox 
                                    x:Name="AddressTextBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"
                                    GotFocus="AddressTextBox_GotFocus"
                                    LostFocus="AddressTextBox_LostFocus"/>
                            </Border>
                            <TextBlock x:Name="AddressPlaceholder" Text="г. Москва, ул. Ленина, д. 10" Foreground="Gray" FontSize="16"
                                       VerticalAlignment="Center" Margin="20,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <!-- Роль -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Роль" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border x:Name="RoleBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <ComboBox 
                                x:Name="RoleComboBox"
                                Padding="12" 
                                FontSize="16"
                                MinHeight="46"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"
                                SelectionChanged="RoleComboBox_SelectionChanged">
                                <ComboBoxItem Content="Teacher"/>
                                <ComboBoxItem Content="Admin"/>
                                <ComboBoxItem Content="Methodologist"/>
                            </ComboBox>
                        </Border>
                        <TextBlock x:Name="RoleErrorText" Foreground="Red" FontSize="14" Margin="0,5,0,0" Visibility="Collapsed">Обязательное поле</TextBlock>
                    </StackPanel>

                    <!-- Специализация (направление) -->
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Специализация (направление)" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <ComboBox x:Name="SpecializationComboBox" FontSize="16" MinHeight="46"
                                      Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Пароль -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                        <TextBlock Text="Пароль" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Grid>
                            <Border x:Name="PasswordBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox 
                                    x:Name="PasswordTextBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"
                                    TextChanged="PasswordTextBox_TextChanged"
                                    GotFocus="PasswordTextBox_GotFocus"
                                    LostFocus="PasswordTextBox_LostFocus"/>
                            </Border>
                            <TextBlock x:Name="PasswordPlaceholder" Text="Введите пароль..." Foreground="Gray" FontSize="16"
                            VerticalAlignment="Center" Margin="20,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock x:Name="PasswordErrorText" Foreground="Red" FontSize="14" Margin="0,5,0,0" Visibility="Collapsed">Обязательное поле</TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3" Margin="0,5,10,0">
                                <Button 
                                    Content="Сгенерировать" 
                                    x:Name="GeneratePasswordButton"
                                    Background="Transparent"
                                    Foreground="White"
                                    FontSize="14" 
                                    FontWeight="SemiBold"
                                    Padding="15,8" 
                                    Height="36"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Click="GeneratePasswordButton_Click"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Учётная запись активна -->
                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                        <CheckBox x:Name="IsActiveCheckBox" Content="Учётная запись активна (снимите флажок, чтобы заблокировать пользователя)"
                                  FontSize="15" Foreground="#9798F3" IsChecked="True" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Служебные поля (только просмотр) -->
                    <StackPanel Grid.Row="7" Grid.Column="0" Margin="0,0,15,12">
                        <TextBlock Text="Организация (Id)" Foreground="#9798F3" FontSize="14" Margin="0,0,0,6"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#F8F8F8">
                            <TextBox x:Name="OrganizationIdDisplay" IsReadOnly="True" Padding="10,6,10,8" FontSize="14" MinHeight="42"
                                     BorderThickness="0" VerticalContentAlignment="Center" Foreground="#555"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="7" Grid.Column="1" Margin="15,0,0,12">
                        <TextBlock Text="Дата создания учётной записи" Foreground="#9798F3" FontSize="14" Margin="0,0,0,6"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#F8F8F8">
                            <TextBox x:Name="UserCreatedDateDisplay" IsReadOnly="True" Padding="10,6,10,8" FontSize="14" MinHeight="42"
                                     BorderThickness="0" VerticalContentAlignment="Center" Foreground="#555"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                        <TextBlock Text="Последний вход" Foreground="#9798F3" FontSize="14" Margin="0,0,0,6"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#F8F8F8">
                            <TextBox x:Name="LastLoginDateDisplay" IsReadOnly="True" Padding="10,6,10,8" FontSize="14" MinHeight="42"
                                     BorderThickness="0" VerticalContentAlignment="Center" Foreground="#555"/>
                        </Border>
                    </StackPanel>

                    <!-- Кнопки -->
                    <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3" Margin="0,0,10,0">
                            <Button 
                                Content="Добавить" 
                                x:Name="AddButton"
                                Background="Transparent"
                                Foreground="White"
                                FontSize="16" 
                                FontWeight="SemiBold"
                                Padding="25,12" 
                                Height="45"
                                Cursor="Hand"
                                BorderThickness="0"
                                Click="AddButton_Click"/>
                        </Border>
                        <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3" Margin="0,0,10,0">
                            <Button 
                                Content="Обновить" 
                                x:Name="UpdateButton"
                                Background="Transparent"
                                Foreground="White"
                                FontSize="16" 
                                FontWeight="SemiBold"
                                Padding="25,12" 
                                Height="45"
                                Cursor="Hand"
                                BorderThickness="0"
                                Click="UpdateButton_Click"/>
                        </Border>
                        <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#FF6B6B" Margin="0,0,10,0">
                            <Button 
                                Content="Удалить" 
                                x:Name="DeleteButton"
                                Background="Transparent"
                                Foreground="White"
                                FontSize="16" 
                                FontWeight="SemiBold"
                                Padding="25,12" 
                                Height="45"
                                Cursor="Hand"
                                BorderThickness="0"
                                Click="DeleteButton_Click"/>
                        </Border>
                        <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#CCCCCC">
                            <Button 
                                Content="Очистить" 
                                x:Name="ClearButton"
                                Background="Transparent"
                                Foreground="White"
                                FontSize="16" 
                                FontWeight="SemiBold"
                                Padding="25,12" 
                                Height="45"
                                Cursor="Hand"
                                BorderThickness="0"
                                Click="ClearButton_Click"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Поиск и таблица -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Поиск:" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" MinWidth="160" Margin="0,0,10,0">
                        <TextBox 
                            x:Name="SearchTextBox"
                            Padding="12" 
                            FontSize="16"
                            MinHeight="46"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalContentAlignment="Center"/>
                    </Border>
                    <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3">
                        <Button 
                            Content="Поиск" 
                            Background="Transparent"
                            Foreground="White"
                            FontSize="16" 
                            FontWeight="SemiBold"
                            Padding="25,12" 
                            Height="45"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="SearchButton_Click"/>
                    </Border>
                </StackPanel>

                <!-- Таблица учителей -->
                <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="20">
                    <DataGrid 
                        x:Name="TeachersDataGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        SelectionMode="Single"
                        SelectionChanged="TeachersDataGrid_SelectionChanged"
                        HeadersVisibility="Column"
                        GridLinesVisibility="All"
                        BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
                            <DataGridTextColumn Header="Специализация" Binding="{Binding SpecializationName}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Найм" Binding="{Binding HireDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="90"/>
                            <DataGridTextColumn Header="Последний вход" Binding="{Binding LastLoginDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Создан" Binding="{Binding CreatedDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="SizeToCells"/>
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
