<Window x:Class="Lesson_Link.TeacherGradesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Оценки"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}">
        <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="Оценки" FontSize="32" Foreground="#9798F3" FontWeight="Bold"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" CornerRadius="8" Background="#9798F3">
                    <Button Content="Назад" Background="Transparent" Foreground="White"
                            FontSize="16" FontWeight="SemiBold" Padding="20,10" Height="40"
                            Cursor="Hand" BorderThickness="0" Click="BackButton_Click"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="30" Margin="0,0,0,30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Группа" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <ComboBox x:Name="GroupComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      MinHeight="46" Padding="12,8,12,10" FontSize="16" Background="Transparent" BorderThickness="0"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="GroupComboBox_SelectionChanged"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Ученик" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <ComboBox x:Name="StudentComboBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                      MinHeight="46" Padding="12,8,12,10" FontSize="16" Background="Transparent" BorderThickness="0"
                                      VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Тип оценки" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <ComboBox x:Name="GradeModeComboBox" MinHeight="46" Padding="12,8,12,10" FontSize="16"
                                      Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Баллы" Tag="Баллы" IsSelected="True"/>
                                <ComboBoxItem Content="Проценты" Tag="Проценты"/>
                                <ComboBoxItem Content="Зачёт / незачёт" Tag="Зачёт"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Значение" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="GradeValueTextBox" MinHeight="46" Padding="12,8,12,10" FontSize="16"
                                     Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                        <TextBlock Text="Занятие (необязательно)" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <ComboBox x:Name="ScheduleComboBox" DisplayMemberPath="Caption"
                                      MinHeight="46" Padding="12,8,12,10" FontSize="16" Background="Transparent" BorderThickness="0"
                                      VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" CornerRadius="8" Background="#9798F3">
                        <Button Content="Сохранить оценку" Background="Transparent" Foreground="White"
                                FontSize="16" FontWeight="SemiBold" Padding="25,12" Height="45"
                                Cursor="Hand" BorderThickness="0" Click="SaveButton_Click"/>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" Text="Недавние оценки ваших учеников" Foreground="White"
                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <Border Grid.Row="3" Background="White" CornerRadius="15" Padding="20" MinHeight="280">
                <DataGrid x:Name="RecentGradesGrid" IsReadOnly="True" AutoGenerateColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAtText}" Width="140"/>
                        <DataGridTextColumn Header="Ученик" Binding="{Binding StudentName}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Занятие" Binding="{Binding LessonText}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding GradeMode}" Width="120"/>
                        <DataGridTextColumn Header="Значение" Binding="{Binding GradeValue}" Width="SizeToCells"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
