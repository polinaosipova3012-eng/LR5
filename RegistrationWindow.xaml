<Window x:Class="Lesson_Link.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Регистрация — LessonLink"
        Style="{StaticResource AppCompactWindow}"
        WindowStartupLocation="CenterOwner"
        MinWidth="420"
        MaxWidth="560"
        Width="520"
        MinHeight="620"
        SizeToContent="Height">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}">
    <Grid Margin="{StaticResource AppPageMargin}" MinWidth="360">
        <Border Background="White" CornerRadius="50" Padding="45" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Регистрация" FontSize="32" Foreground="#9798F3"
                           HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,28"/>

                <TextBlock Text="Логин (email)" Foreground="#9798F3" FontSize="16" Margin="0,0,0,4"/>
                <TextBlock Text="Уникальный идентификатор для входа. Обязательное поле, формат RFC 5322."
                           FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Border x:Name="EmailFieldBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="0,0,0,18">
                    <TextBox x:Name="EmailTextBox" Padding="12,9,12,11" FontSize="16" MinHeight="50"
                             Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="Пароль" Foreground="#9798F3" FontSize="16" Margin="0,0,0,4"/>
                <TextBlock Text="Не менее 6 символов: заглавная и строчная буква, цифра."
                           FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Border x:Name="PasswordFieldBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="0,0,0,18">
                    <PasswordBox x:Name="PasswordBox" Padding="{StaticResource AppInputPaddingLarge}" FontSize="16" MinHeight="50"
                                 VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="Подтверждение пароля" Foreground="#9798F3" FontSize="16" Margin="0,0,0,4"/>
                <TextBlock Text="Повторите пароль для проверки совпадения."
                           FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Border x:Name="ConfirmPasswordFieldBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="0,0,0,18">
                    <PasswordBox x:Name="ConfirmPasswordBox" Padding="{StaticResource AppInputPaddingLarge}" FontSize="16" MinHeight="50"
                                 VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="Название организации" Foreground="#9798F3" FontSize="16" Margin="0,0,0,4"/>
                <TextBlock Text="Полное наименование образовательной организации. Обязательное поле."
                           FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Border x:Name="OrgNameFieldBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="0,0,0,24">
                    <TextBox x:Name="OrganizationNameTextBox" Padding="12,9,12,11" FontSize="16" MinHeight="50"
                             Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                </Border>

                <Border CornerRadius="25" Background="#9798F3" Margin="0,0,0,12">
                    <Button Content="Продолжить" Style="{StaticResource FlatButtonStyle}"
                            FontSize="18" FontWeight="SemiBold" Padding="20,12" Height="54" Cursor="Hand"
                            Click="ContinueButton_Click"/>
                </Border>

                <Button Content="Назад к входу" Background="Transparent" Foreground="#9798F3"
                        FontSize="15" BorderThickness="0" Cursor="Hand" Click="BackToLogin_Click"/>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
