<Window x:Class="Lesson_Link.TeacherAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Посещаемость"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}">
    <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Посещаемость" FontSize="32" Foreground="#9798F3" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Border HorizontalAlignment="Right" CornerRadius="8" Background="#9798F3">
                <Button Content="Назад" Background="Transparent" Foreground="White"
                        FontSize="16" FontWeight="SemiBold" Padding="20,10" Height="40"
                        Cursor="Hand" BorderThickness="0" Click="BackButton_Click"/>
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#9798F3"/>
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="White" CornerRadius="10,10,0,0"
                                        Margin="0,0,8,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#9798F3"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Вкладка: отметка по занятию -->
            <TabItem Header="По занятию">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="15" Padding="25" Margin="0,0,20,0">
                            <StackPanel>
                                <TextBlock Text="Дата занятия" Foreground="#9798F3" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DatePicker x:Name="LessonDatePicker" Height="45" FontSize="14"
                                            SelectedDateChanged="LessonDatePicker_SelectedDateChanged" Margin="0,0,0,20"/>

                                <TextBlock Text="Выберите занятие" Foreground="#9798F3" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                    <ListBox x:Name="ScheduleListBox" DisplayMemberPath="Caption" MinHeight="300"
                                             BorderThickness="0" Background="Transparent" Padding="4"
                                             SelectionChanged="ScheduleListBox_SelectionChanged"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="LessonHintTextBlock" Grid.Row="0"
                                           Text="Выберите занятие слева, затем отметьте присутствие учеников"
                                           Foreground="#9798F3" FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,0,0,15"/>
                                <DataGrid x:Name="StudentsGrid" Grid.Row="1" AutoGenerateColumns="False"
                                          CanUserAddRows="False" HeadersVisibility="Column"
                                          GridLinesVisibility="All" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ученик" Binding="{Binding FullName}" Width="SizeToCells" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="Присутствовал" Width="130"
                                            Binding="{Binding IsPresent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Отмечено" Binding="{Binding MarkedAtText}" Width="150" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" HorizontalAlignment="Right" CornerRadius="8" Background="#9798F3" Margin="0,20,0,0">
                        <Button Content="Сохранить посещаемость на занятии" Background="Transparent" Foreground="White"
                                FontSize="16" FontWeight="SemiBold" Padding="25,12" Height="45"
                                Cursor="Hand" BorderThickness="0" Click="SaveLessonAttendanceButton_Click"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка: история по ученику -->
            <TabItem Header="По ученику">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="15" Padding="25" Margin="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="Выберите ученика" Foreground="#9798F3" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                <ComboBox x:Name="StudentComboBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                          MinHeight="46" Padding="12,8,12,10" FontSize="16" Background="Transparent" BorderThickness="0"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="StudentComboBox_SelectionChanged"/>
                            </Border>
                            <TextBlock x:Name="StudentHintTextBlock" Text="Показаны занятия ваших групп, на которые зачислен ученик"
                                       Foreground="#666" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="StudentAttendanceTitleTextBlock" Grid.Row="0"
                                       Text="История посещаемости" Foreground="#9798F3" FontSize="16"
                                       FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <DataGrid x:Name="StudentAttendanceGrid" Grid.Row="1" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата и время" Binding="{Binding LessonDateTime}" Width="SizeToCells"/>
                                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="SizeToCells"/>
                                    <DataGridTextColumn Header="Тема" Binding="{Binding Topic}" Width="SizeToCells"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="130"/>
                                    <DataGridTextColumn Header="Отмечено" Binding="{Binding MarkedAtText}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
    </ScrollViewer>
</Window>
