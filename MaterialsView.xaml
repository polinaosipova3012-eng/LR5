<UserControl x:Class="Lesson_Link.MaterialsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson_Link"
        mc:Ignorable="d"
        d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}">
    <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="240"/>
            <ColumnDefinition Width="7*" MinWidth="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с кнопкой возврата -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,30">
            <TextBlock 
                Text="Методика" 
                FontSize="32" 
                Foreground="#9798F3" 
                FontWeight="Bold"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"/>
            <Border HorizontalAlignment="Right" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3">
                <Button 
                    Content="Главная панель" 
                    Background="Transparent"
                    Foreground="White"
                    FontSize="16" 
                    FontWeight="SemiBold"
                    Padding="20,10" 
                    Height="40"
                    Cursor="Hand"
                    BorderThickness="0"
                    Click="BackButton_Click"/>
            </Border>
        </Grid>

        <!-- Левая панель: Древовидная структура и кнопки -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
            <StackPanel>
                <!-- Кнопка загрузки -->
                <Border 
                    Background="White"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock 
                            Text="Учебный материал" 
                            FontSize="18" 
                            Foreground="#9798F3" 
                            FontWeight="SemiBold"
                            Margin="0,0,0,15"/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Организация (Id)" Foreground="#9798F3" FontSize="14" Margin="0,0,0,6"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#F8F8F8">
                                <TextBox x:Name="OrganizationIdDisplay" IsReadOnly="True" Padding="10,6,10,8" FontSize="14" MinHeight="40"
                                         BorderThickness="0" VerticalContentAlignment="Center" Foreground="#555"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Номер материала (Id)" Foreground="#9798F3" FontSize="14" Margin="0,0,0,6"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#F8F8F8">
                                <TextBox x:Name="MaterialIdDisplay" IsReadOnly="True" Padding="10,6,10,8" FontSize="14" MinHeight="40"
                                         BorderThickness="0" VerticalContentAlignment="Center" Foreground="#555"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Группа" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <ComboBox x:Name="GroupComboBox" FontSize="16" MinHeight="46"
                                          Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Название" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox x:Name="TitleTextBox" FontSize="16" MinHeight="46"
                                         Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Описание" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <TextBox x:Name="DescriptionTextBox" FontSize="15" MinHeight="60"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Background="Transparent" BorderThickness="0" VerticalContentAlignment="Top"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Тип файла" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <ComboBox x:Name="FileTypeComboBox" FontSize="16" MinHeight="46"
                                          Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
                            </Border>
                        </StackPanel>

                        <CheckBox x:Name="IsRequiredCheckBox" Content="Обязательный материал"
                                  FontSize="15" Foreground="#9798F3" IsChecked="True" Margin="0,0,0,12"/>

                        <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3" Margin="0,0,0,8">
                            <Button Content="Выбрать файл" x:Name="SelectFileButton"
                                    Background="Transparent" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                    Padding="16,10" Height="42" Cursor="Hand" BorderThickness="0"
                                    Click="SelectFileButton_Click"/>
                        </Border>
                        <TextBlock x:Name="SelectedFileTextBlock" Text="Файл не выбран" FontSize="14" Foreground="#666"
                                   Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Background="#9798F3" Margin="0,0,4,0">
                                <Button Content="Загрузить" x:Name="UploadButton"
                                        Background="Transparent" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                        Padding="12,10" Height="40" Cursor="Hand" BorderThickness="0"
                                        Click="UploadButton_Click"/>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="8" Background="#9798F3" Margin="4,0,0,0">
                                <Button Content="Обновить" x:Name="UpdateButton"
                                        Background="Transparent" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                        Padding="12,10" Height="40" Cursor="Hand" BorderThickness="0"
                                        Click="UpdateButton_Click"/>
                            </Border>
                        </Grid>
                        <Border CornerRadius="8" Background="#CCCCCC" Margin="0,8,0,0">
                            <Button Content="Очистить" x:Name="ClearFormButton"
                                    Background="Transparent" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                    Padding="12,10" Height="36" Cursor="Hand" BorderThickness="0"
                                    Click="ClearFormButton_Click"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Древовидная структура -->
                <Border 
                    Background="White"
                    CornerRadius="15"
                    Padding="20">
                    <StackPanel>
                        <TextBlock 
                            Text="Материалы по группам" 
                            FontSize="18" 
                            Foreground="#9798F3" 
                            FontWeight="SemiBold"
                            Margin="0,0,0,15"/>
                        
                        <TreeView 
                            x:Name="MaterialsTreeView"
                            SelectedItemChanged="MaterialsTreeView_SelectedItemChanged"
                            BorderThickness="0">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Materials}">
                                    <TextBlock Text="{Binding Name}" FontSize="16" Foreground="#333" FontWeight="SemiBold"/>
                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="5,2">
                                                <TextBlock FontSize="14" Foreground="#666" TextWrapping="Wrap">
                                                    <Run Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <Run Text=" · " Foreground="#999"/>
                                                    <Run Text="{Binding FileType}" Foreground="#999"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#9798F3" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="обязательный"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Правая панель: Просмотр и управление -->
        <Border 
            Grid.Row="1" Grid.Column="1"
            Background="White"
            CornerRadius="15"
            Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Информация о выбранном материале -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock 
                        x:Name="MaterialTitleTextBlock"
                        Text="Выберите материал из списка" 
                        FontSize="20" 
                        Foreground="#9798F3" 
                        FontWeight="SemiBold"
                        Margin="0,0,0,10"/>
                    <TextBlock 
                        x:Name="MaterialInfoTextBlock"
                        Text="" 
                        FontSize="14" 
                        Foreground="#666"
                        TextWrapping="Wrap"
                        Margin="0,0,0,10"/>
                    <TextBlock 
                        x:Name="MaterialDescriptionTextBlock"
                        Text="" 
                        FontSize="14" 
                        Foreground="#333"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Область просмотра файла -->
                <Border 
                    Grid.Row="1"
                    BorderBrush="#CCCCCC" 
                    BorderThickness="1" 
                    CornerRadius="10"
                    Background="#F5F5F5">
                    <Grid x:Name="PreviewGrid">
                        <!-- Для изображений -->
                        <Image 
                            x:Name="ImagePreview"
                            Stretch="Uniform"
                            Visibility="Collapsed"/>
                        
                        <!-- Для видео -->
                        <MediaElement 
                            x:Name="VideoPreview"
                            LoadedBehavior="Manual"
                            UnloadedBehavior="Stop"
                            Visibility="Collapsed"/>
                        
                        <!-- Для PDF и других документов -->
                        <WebBrowser 
                            x:Name="DocumentPreview"
                            Visibility="Collapsed"/>
                        
                        <!-- Сообщение когда ничего не выбрано -->
                        <TextBlock 
                            x:Name="NoPreviewTextBlock"
                            Text="Выберите материал для просмотра" 
                            FontSize="18" 
                            Foreground="#999"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Кнопки управления -->
                <StackPanel 
                    Grid.Row="2"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
                    <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3" Margin="0,0,10,0">
                        <Button 
                            Content="Просмотреть" 
                            x:Name="ViewButton"
                            Background="Transparent"
                            Foreground="White"
                            FontSize="16" 
                            FontWeight="SemiBold"
                            Padding="25,12" 
                            Height="45"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="ViewButton_Click"
                            IsEnabled="False"/>
                    </Border>
                    <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#FF6B6B">
                        <Button 
                            Content="Удалить" 
                            x:Name="DeleteButton"
                            Background="Transparent"
                            Foreground="White"
                            FontSize="16" 
                            FontWeight="SemiBold"
                            Padding="25,12" 
                            Height="45"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="DeleteButton_Click"
                            IsEnabled="False"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
