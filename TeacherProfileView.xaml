<Window x:Class="Lesson_Link.TeacherProfileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson_Link"
        mc:Ignorable="d"
        Title="Личные данные" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}">
        <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок с кнопкой возврата -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <TextBlock 
                    Text="Личные данные" 
                    FontSize="32" 
                    Foreground="#9798F3" 
                    FontWeight="Bold"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3">
                    <Button 
                        Content="Назад" 
                        Background="Transparent"
                        Foreground="White"
                        FontSize="16" 
                        FontWeight="SemiBold"
                        Padding="20,10" 
                        Height="40"
                        Cursor="Hand"
                        BorderThickness="0"
                        Click="BackButton_Click"/>
                </Border>
            </Grid>

            <!-- Форма личных данных -->
            <Border 
                Grid.Row="1"
                Background="White"
                CornerRadius="15"
                Padding="30"
                Margin="0,0,0,30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Имя (только чтение) -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Имя" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Background="#F5F5F5">
                            <TextBox 
                                x:Name="FirstNameTextBox"
                                Padding="12" 
                                FontSize="16"
                                MinHeight="46"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"
                                IsReadOnly="True"/>
                        </Border>
                    </StackPanel>

                    <!-- Фамилия (только чтение) -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Фамилия" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Background="#F5F5F5">
                            <TextBox 
                                x:Name="LastNameTextBox"
                                Padding="12" 
                                FontSize="16"
                                MinHeight="46"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"
                                IsReadOnly="True"/>
                        </Border>
                    </StackPanel>

                    <!-- Отчество (только чтение) -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Отчество" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Background="#F5F5F5">
                            <TextBox x:Name="MiddleNameTextBox" FontSize="16" MinHeight="46"
                                     Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                     IsReadOnly="True"/>
                        </Border>
                    </StackPanel>

                    <!-- Дата найма (только чтение) -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Дата найма" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Background="#F5F5F5">
                            <TextBox x:Name="HireDateDisplay" FontSize="16" MinHeight="46"
                                     Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                     IsReadOnly="True"/>
                        </Border>
                    </StackPanel>

                    <!-- Email (только чтение) -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Email" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Background="#F5F5F5">
                            <TextBox 
                                x:Name="EmailTextBox"
                                Padding="12" 
                                FontSize="16"
                                MinHeight="46"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"
                                IsReadOnly="True"/>
                        </Border>
                    </StackPanel>

                    <!-- Роль (только чтение) -->
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Роль" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Background="#F5F5F5">
                            <TextBox 
                                x:Name="RoleTextBox"
                                Padding="12" 
                                FontSize="16"
                                MinHeight="46"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"
                                IsReadOnly="True"/>
                        </Border>
                    </StackPanel>

                    <!-- Телефон (редактируемое) -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Телефон" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <TextBox 
                                x:Name="PhoneNumberTextBox"
                                Padding="12" 
                                FontSize="16"
                                MinHeight="46"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Адрес (редактируемое) -->
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Адрес" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <TextBox 
                                x:Name="AddressTextBox"
                                Padding="12" 
                                FontSize="16"
                                MinHeight="46"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Специализация (только чтение) -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Специализация (направление)" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Background="#F5F5F5">
                            <TextBox x:Name="SpecializationDisplay" FontSize="16" MinHeight="46"
                                     Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                     IsReadOnly="True"/>
                        </Border>
                    </StackPanel>

                    <!-- Статус учётной записи (только чтение) -->
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Статус учётной записи" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Background="#F5F5F5">
                            <TextBox x:Name="IsActiveDisplay" FontSize="16" MinHeight="46"
                                     Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                     IsReadOnly="True"/>
                        </Border>
                    </StackPanel>

                    <!-- Служебные поля -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,15,12">
                        <TextBlock Text="Номер пользователя (Id)" Foreground="#9798F3" FontSize="14" Margin="0,0,0,6"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#F8F8F8">
                            <TextBox x:Name="UserIdDisplay" IsReadOnly="True" Padding="10,6,10,8" FontSize="14" MinHeight="42"
                                     BorderThickness="0" VerticalContentAlignment="Center" Foreground="#555"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="15,0,0,12">
                        <TextBlock Text="Организация (Id)" Foreground="#9798F3" FontSize="14" Margin="0,0,0,6"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#F8F8F8">
                            <TextBox x:Name="OrganizationIdDisplay" IsReadOnly="True" Padding="10,6,10,8" FontSize="14" MinHeight="42"
                                     BorderThickness="0" VerticalContentAlignment="Center" Foreground="#555"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,15,12">
                        <TextBlock Text="Дата создания учётной записи" Foreground="#9798F3" FontSize="14" Margin="0,0,0,6"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#F8F8F8">
                            <TextBox x:Name="UserCreatedDateDisplay" IsReadOnly="True" Padding="10,6,10,8" FontSize="14" MinHeight="42"
                                     BorderThickness="0" VerticalContentAlignment="Center" Foreground="#555"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="6" Grid.Column="1" Margin="15,0,0,12">
                        <TextBlock Text="Последний вход" Foreground="#9798F3" FontSize="14" Margin="0,0,0,6"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#F8F8F8">
                            <TextBox x:Name="LastLoginDateDisplay" IsReadOnly="True" Padding="10,6,10,8" FontSize="14" MinHeight="42"
                                     BorderThickness="0" VerticalContentAlignment="Center" Foreground="#555"/>
                        </Border>
                    </StackPanel>

                    <!-- Кнопка сохранения данных -->
                    <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3" Margin="0,10,0,0">
                        <Button 
                            Content="Сохранить данные" 
                            Background="Transparent"
                            Foreground="White"
                            FontSize="16" 
                            FontWeight="SemiBold"
                            Padding="25,12" 
                            Height="45"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="SaveDataButton_Click"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Форма смены пароля -->
            <Border 
                Grid.Row="2"
                Background="White"
                CornerRadius="15"
                Padding="30">
                <StackPanel>
                    <TextBlock 
                        Text="Смена пароля" 
                        FontSize="20" 
                        Foreground="#9798F3" 
                        FontWeight="SemiBold"
                        Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Текущий пароль -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Текущий пароль" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border x:Name="CurrentPasswordBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <PasswordBox 
                                    x:Name="CurrentPasswordBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Новый пароль -->
                        <StackPanel Grid.Column="1" Margin="15,0,15,0">
                            <TextBlock Text="Новый пароль" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border x:Name="NewPasswordBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <PasswordBox 
                                    x:Name="NewPasswordBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Подтверждение пароля -->
                        <StackPanel Grid.Column="2" Margin="15,0,0,0">
                            <TextBlock Text="Подтвердите пароль" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                            <Border x:Name="ConfirmPasswordBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                                <PasswordBox 
                                    x:Name="ConfirmPasswordBox"
                                    Padding="12" 
                                    FontSize="16"
                                    MinHeight="46"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Кнопка смены пароля -->
                    <Border HorizontalAlignment="Right" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#FF6B6B" Margin="0,20,0,0">
                        <Button 
                            Content="Сменить пароль" 
                            Background="Transparent"
                            Foreground="White"
                            FontSize="16" 
                            FontWeight="SemiBold"
                            Padding="25,12" 
                            Height="45"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="ChangePasswordButton_Click"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>

