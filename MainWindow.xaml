<Window x:Class="Lesson_Link.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson_Link"
        mc:Ignorable="d"
        Title="LessonLink"
        Style="{StaticResource AppCompactWindow}"
        MinWidth="480"
        MinHeight="520"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}">
        <Grid Margin="{StaticResource AppPageMargin}" MinWidth="360">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock FontSize="100" Foreground="#9798F3" FontWeight="Bold" Text="LL" />
                <TextBlock FontSize="20" Foreground="#9798F3" Margin="0,-10,0,0">LessonLink</TextBlock>
            </StackPanel>

            <Border 
                Grid.Row="1"
                Background="White"
                CornerRadius="50"
                Padding="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="320"
                MaxWidth="600"
                Margin="0,24,0,24">

                <StackPanel>
                    <TextBlock 
                        Text="Вход" 
                        FontSize="36" 
                        Foreground="#9798F3" 
                        HorizontalAlignment="Center" 
                        FontWeight="SemiBold"
                        Margin="0,0,0,35"/>

                    <StackPanel Margin="0,0,0,30">
                        <TextBlock Text="Логин" Foreground="#9798F3" FontSize="18" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <TextBox 
                                x:Name="LoginTextBox"
                                Padding="{StaticResource AppInputPaddingLarge}"
                                FontSize="18"
                                MinHeight="{StaticResource AppInputMinHeightLarge}"
                                Background="Transparent"
                                BorderThickness="0"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,30">
                        <TextBlock Text="Пароль" Foreground="#9798F3" FontSize="18" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <PasswordBox 
                                x:Name="PasswordBox"
                                Padding="{StaticResource AppInputPaddingLarge}"
                                FontSize="18"
                                MinHeight="{StaticResource AppInputMinHeightLarge}"
                                Background="Transparent"
                                BorderThickness="0"/>
                        </Border>
                    </StackPanel>

                    <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="25" Background="#9798F3">
                        <Button 
                            Content="Войти" 
                            Style="{StaticResource FlatButtonStyle}"
                            FontSize="20" 
                            FontWeight="SemiBold"
                            Padding="20,12" 
                            Height="60"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand"
                            VerticalContentAlignment="Center"
                            Click="LoginButton_Click"/>
                    </Border>

                    <TextBlock HorizontalAlignment="Center" Margin="0,22,0,0" FontSize="16">
                        <Hyperlink Click="RegisterHyperlink_Click" TextDecorations="Underline" Foreground="#9798F3">
                            <Run Text="Нет аккаунта? Зарегистрируйтесь" FontWeight="SemiBold"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
