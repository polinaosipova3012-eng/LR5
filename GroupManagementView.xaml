<UserControl x:Class="Lesson_Link.GroupManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson_Link"
        mc:Ignorable="d"
        d:DesignHeight="900" d:DesignWidth="1200">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}" Background="Transparent">
        <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок с кнопкой возврата -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <TextBlock 
                    Text="Управление группами" 
                    FontSize="32" 
                    Foreground="#9798F3" 
                    FontWeight="Bold"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3">
                    <Button 
                        Content="Главная панель" 
                        Background="Transparent"
                        Foreground="White"
                        FontSize="16" 
                        FontWeight="SemiBold"
                        Padding="20,10" 
                        Height="40"
                        Cursor="Hand"
                        BorderThickness="0"
                        Click="BackButton_Click"/>
                </Border>
            </Grid>

            <!-- Форма добавления/редактирования -->
            <Border 
                Grid.Row="1"
                Background="White"
                CornerRadius="15"
                Padding="30"
                Margin="0,0,0,30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Название группы -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                        <TextBlock Text="Название группы" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <TextBox 
                                x:Name="NameTextBox"
                                Padding="12" 
                                FontSize="16"
                                MinHeight="46"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Уровень подготовки -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Уровень подготовки" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <ComboBox 
                                x:Name="LevelComboBox"
                                Padding="12" 
                                FontSize="16"
                                MinHeight="46"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Статус набора -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Статус набора" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <ComboBox 
                                x:Name="EnrollmentStatusComboBox"
                                Padding="12" 
                                FontSize="16"
                                MinHeight="46"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Направление и возраст -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Направление" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <ComboBox x:Name="DirectionComboBox" FontSize="16" MinHeight="46"
                                      Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Возрастная категория" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <ComboBox x:Name="AgeGroupComboBox" FontSize="16" MinHeight="46"
                                      Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Формат занятий -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                        <TextBlock Text="Формат занятий" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <ComboBox x:Name="LessonFormatComboBox" FontSize="16" MinHeight="46"
                                      Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Макс. учеников в группе" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="MaxStudentsTextBox" FontSize="16" MinHeight="46" Background="Transparent"
                                     BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Текущее число учеников" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="CurrentStudentsTextBox" FontSize="16" MinHeight="46" Background="Transparent"
                                     BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,15,20">
                        <TextBlock Text="Стоимость в месяц (руб.)" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="PricePerMonthTextBox" FontSize="16" MinHeight="46" Background="Transparent"
                                     BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="15,0,0,20">
                        <TextBlock Text="Аудитория" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="RoomTextBox" FontSize="16" MinHeight="46" Background="Transparent"
                                     BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                        <TextBlock Text="Описание" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="DescriptionTextBox" FontSize="16" MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Top"/>
                        </Border>
                    </StackPanel>

                    <!-- Дата создания -->
                    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                        <TextBlock Text="Дата создания" Foreground="#9798F3" FontSize="16" Margin="0,0,0,8"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
                            <DatePicker 
                                x:Name="CreatedDatePicker"
                                Padding="12" 
                                FontSize="16"
                                Height="45"
                                VerticalContentAlignment="Center">
                                <DatePicker.Resources>
                                    <Style TargetType="DatePickerTextBox">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="12"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
                        <CheckBox x:Name="GroupIsActiveCheckBox" Content="Группа активна"
                                  FontSize="15" Foreground="#9798F3" IsChecked="True"/>
                    </StackPanel>

                    <!-- Кнопки -->
                    <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3" Margin="0,0,10,0">
                            <Button 
                                Content="Добавить" 
                                x:Name="AddButton"
                                Background="Transparent"
                                Foreground="White"
                                FontSize="16" 
                                FontWeight="SemiBold"
                                Padding="25,12" 
                                Height="45"
                                Cursor="Hand"
                                BorderThickness="0"
                                Click="AddButton_Click"/>
                        </Border>
                        <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3" Margin="0,0,10,0">
                            <Button 
                                Content="Обновить" 
                                x:Name="UpdateButton"
                                Background="Transparent"
                                Foreground="White"
                                FontSize="16" 
                                FontWeight="SemiBold"
                                Padding="25,12" 
                                Height="45"
                                Cursor="Hand"
                                BorderThickness="0"
                                Click="UpdateButton_Click"/>
                        </Border>
                        <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#FF6B6B" Margin="0,0,10,0">
                            <Button 
                                Content="В архив" 
                                x:Name="DeleteButton"
                                Background="Transparent"
                                Foreground="White"
                                FontSize="16" 
                                FontWeight="SemiBold"
                                Padding="25,12" 
                                Height="45"
                                Cursor="Hand"
                                BorderThickness="0"
                                Click="DeleteButton_Click"/>
                        </Border>
                        <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3" Margin="0,0,10,0">
                            <Button 
                                Content="Восстановить" 
                                x:Name="RestoreButton"
                                Background="Transparent"
                                Foreground="White"
                                FontSize="16" 
                                FontWeight="SemiBold"
                                Padding="25,12" 
                                Height="45"
                                Cursor="Hand"
                                BorderThickness="0"
                                Click="RestoreButton_Click"/>
                        </Border>
                        <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#CCCCCC">
                            <Button 
                                Content="Очистить" 
                                x:Name="ClearButton"
                                Background="Transparent"
                                Foreground="White"
                                FontSize="16" 
                                FontWeight="SemiBold"
                                Padding="25,12" 
                                Height="45"
                                Cursor="Hand"
                                BorderThickness="0"
                                Click="ClearButton_Click"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Поиск и таблица -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Поиск:" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" MinWidth="160" Margin="0,0,10,0">
                        <TextBox 
                            x:Name="SearchTextBox"
                            Padding="12" 
                            FontSize="16"
                            MinHeight="46"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalContentAlignment="Center"/>
                    </Border>
                    <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Background="#9798F3">
                        <Button 
                            Content="Поиск" 
                            Background="Transparent"
                            Foreground="White"
                            FontSize="16" 
                            FontWeight="SemiBold"
                            Padding="25,12" 
                            Height="45"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="SearchButton_Click"/>
                    </Border>
                </StackPanel>

                <!-- Таблица групп -->
                <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="20">
                    <DataGrid 
                        x:Name="GroupsDataGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        SelectionMode="Single"
                        SelectionChanged="GroupsDataGrid_SelectionChanged"
                        HeadersVisibility="Column"
                        GridLinesVisibility="All"
                        BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Направление" Binding="{Binding DirectionName}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Возраст" Binding="{Binding AgeGroupName}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Формат" Binding="{Binding LessonFormatName}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Статус набора" Binding="{Binding EnrollmentStatus}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Макс. уч." Binding="{Binding MaxStudents}" Width="70"/>
                            <DataGridTextColumn Header="Сейчас" Binding="{Binding CurrentStudents}" Width="60"/>
                            <DataGridTextColumn Header="Цена/мес" Binding="{Binding PricePerMonth, StringFormat='{}{0:N2}'}" Width="90"/>
                            <DataGridTextColumn Header="Аудитория" Binding="{Binding Room}" Width="SizeToCells"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="SizeToCells"/>
                            <DataGridCheckBoxColumn Header="Активна" Binding="{Binding IsActive}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="SizeToCells"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
