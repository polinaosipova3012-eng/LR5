<Window x:Class="Lesson_Link.TeacherMaterialsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Методика"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#9798F3" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <ScrollViewer Style="{StaticResource AppRootScrollViewer}">
    <Grid Margin="{StaticResource AppPageMargin}" MinWidth="720">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="240"/>
            <ColumnDefinition Width="7*" MinWidth="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,30">
            <TextBlock Text="Методика" FontSize="32" Foreground="#9798F3" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Border HorizontalAlignment="Right" CornerRadius="8" Background="#9798F3">
                <Button Content="Назад" Background="Transparent" Foreground="White"
                        FontSize="16" FontWeight="SemiBold" Padding="20,10" Height="40"
                        Cursor="Hand" BorderThickness="0" Click="BackButton_Click"/>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
            <Border Background="White" CornerRadius="15" Padding="20">
                <StackPanel>
                    <TextBlock Text="Материалы ваших групп" FontSize="18" Foreground="#9798F3"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Доступны материалы организации по группам, в которых вы преподаёте"
                               Foreground="#666" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <TreeView x:Name="MaterialsTreeView"
                              SelectedItemChanged="MaterialsTreeView_SelectedItemChanged"
                              BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Materials}">
                                <TextBlock Text="{Binding Name}" FontSize="16" Foreground="#333" FontWeight="SemiBold"/>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,2">
                                            <TextBlock FontSize="14" Foreground="#666" TextWrapping="Wrap">
                                                <Run Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <Run Text=" · " Foreground="#999"/>
                                                <Run Text="{Binding FileType}" Foreground="#999"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#9798F3" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="обязательный"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="15" Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock x:Name="MaterialTitleTextBlock"
                               Text="Выберите материал из списка"
                               FontSize="20" Foreground="#9798F3" FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="MaterialInfoTextBlock" Text=""
                               FontSize="14" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="MaterialDescriptionTextBlock" Text=""
                               FontSize="14" Foreground="#333" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1"
                        CornerRadius="10" Background="#F5F5F5">
                    <Grid>
                        <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed"/>
                        <MediaElement x:Name="VideoPreview" LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop" Visibility="Collapsed"/>
                        <WebBrowser x:Name="DocumentPreview" Visibility="Collapsed"/>
                        <TextBlock x:Name="NoPreviewTextBlock"
                                   Text="Выберите материал для просмотра"
                                   FontSize="18" Foreground="#999"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" HorizontalAlignment="Right" CornerRadius="8" Background="#9798F3" Margin="0,20,0,0">
                    <Button Content="Просмотреть" x:Name="ViewButton"
                            Background="Transparent" Foreground="White"
                            FontSize="16" FontWeight="SemiBold" Padding="25,12" Height="45"
                            Cursor="Hand" BorderThickness="0" Click="ViewButton_Click"
                            IsEnabled="False"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
